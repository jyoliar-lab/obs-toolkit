# obs-toolkit — 코어가 읽는 env 전부. 복사해서 .env 로 쓰거나(셸에서 직접 부를 때), Claude Code 에서는
# 프로젝트의 .claude/settings.local.json(gitignored) 의 "env" 블록에 같은 이름으로 둔다:
#   { "env": { "OBS_GRAFANA_TOKEN": "..." } }
# 이 파일에 실제 토큰을 적지 않는다. .env 는 gitignored 다.

# ── 필수 ────────────────────────────────────────────────────────────────────────
# Grafana 서비스 계정 토큰(Bearer). 사람이 Secret 에서 꺼낸다. env 로만 받는다 — 설정 파일·인자로는 받지 않는다.
OBS_GRAFANA_TOKEN=glsa_replace_me

# ── 물리 경로 — 보통 비워 둔다(내장 기본값 = 로컬 agent 게이트웨이) ─────────────────
# 해석 순서: env → 설정 파일(OBS_CONFIG → $CLAUDE_PLUGIN_DATA/config.json → ~/.config/obs-toolkit/config.json) → 내장 기본값
# 클러스터 내 소비자는 Grafana 서비스 주소를 준다. 예: http://monitoring-grafana.prometheus.svc
#OBS_GRAFANA_URL=
# 데이터소스 프록시 prefix. 기본 /api/datasources/proxy/uid
#OBS_PROXY_PREFIX=
# 논리 이름 → Grafana 데이터소스 uid
#OBS_UID_METRICS=
#OBS_UID_LOGS=
#OBS_UID_TRACES=
# 설정 파일 경로를 직접 지정할 때(JSON: grafana_url · proxy_prefix · uids.{metrics,logs,traces})
#OBS_CONFIG=

# ── 자리 ─────────────────────────────────────────────────────────────────────────
# 호출 디렉터리(원본·요약)가 떨어지는 프로젝트 루트($CLAUDE_PROJECT_DIR/tmp/obs). Claude Code 가 주입한다 — 셸에서 직접 부를 때만 준다
#CLAUDE_PROJECT_DIR=

# ── 프록시 — env 만 본다(OS 시스템 프록시 설정은 조회하지 않는다) ────────────────────
#HTTP_PROXY=
#HTTPS_PROXY=
#NO_PROXY=

# ── 개발 ─────────────────────────────────────────────────────────────────────────
# 1 이면 pytest 가 각 테스트의 Evidence.lines 를 tmp/test-output/ 에 덤프한다
#OBS_TEST_DUMP=
